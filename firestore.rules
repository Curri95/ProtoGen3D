rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexcurrito97@gmail.com'
      );
    }

    function isValidQuote(data) {
      return data.ticketNumber is string && data.ticketNumber.size() <= 32
        && data.company is string && data.company.size() <= 150
        && data.email is string && data.email.size() <= 150
        && data.technology is string && data.technology.size() <= 80
        && data.material is string && data.material.size() <= 80
        && data.quantity is number && data.quantity > 0;
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.email == request.auth.token.email || 
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() 
        && isValidId(quoteId) 
        && isValidQuote(request.resource.data)
        && (request.resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isSignedIn() 
        && isValidId(quoteId) 
        && isValidQuote(request.resource.data)
        && (
          isAdmin() || 
          (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'syncedToSheets', 'notes']))
        );

      allow delete: if isAdmin();
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow delete: if isAdmin();
    }

  }
}
